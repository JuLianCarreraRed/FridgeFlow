{
  "name": "fridgeflow",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Planificador semanal de menus con los alimentos que ya tienes en casa. Web 100 % estatica.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "datos": "node scripts/check-datos.mjs",
    "datos:estricto": "node scripts/check-datos.mjs --strict",
    "datos:generar": "node scripts/generar-txt.mjs",
    "datos:generar:escribir": "node scripts/generar-txt.mjs --write",
    "test": "node --test",
    "check": "npm run datos && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
